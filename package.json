{
  "name": "evomc-manager",
  "version": "1.0.0",
  "private": true,
  "description": "A production-ready Discord moderation and Minecraft status bot.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy-commands": "node dist/deploy-commands.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "minecraft-server-util": "^5.4.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2"
  }
}